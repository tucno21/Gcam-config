# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está ignorado por git. NUNCA subas credenciales al repositorio.
#
# Solo variables con prefijo VITE_ llegan al navegador: aquí únicamente puede ir
# la clave PÚBLICA (publishable / anon) de Supabase.
# Prohibido usar service_role o cualquier clave privilegiada en el frontend.

# URL del proyecto de Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Clave pública (publishable) de Supabase: sb_publishable_…
# También se acepta el nombre heredado VITE_SUPABASE_ANON_KEY como respaldo.
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Base de la API propia (Etapa 11). En desarrollo se usa /api.
# VITE_API_BASE_URL=/api
